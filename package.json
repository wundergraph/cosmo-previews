{
  "name": "cosmo-previews",
  "version": "0.0.0",
  "private": true,
  "keywords": [
    "actions",
    "node",
    "setup"
  ],
  "license": "MIT",
  "author": "",
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint --type-aware .",
    "lint:fix": "oxlint --type-aware --fix .",
    "lint:types": "tsc --noEmit",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "test": "vitest run",
    "test:ci": "vitest run --reporter=default --reporter=github-actions",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@actions/exec": "^3.0.0",
    "@actions/github": "^9.0.0",
    "@octokit/rest": "^22.0.1",
    "js-yaml": "^4.1.0",
    "micromatch": "^4.0.7",
    "pathe": "^2.0.3",
    "wgc": "^0.112.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/micromatch": "^4.0.9",
    "@types/node": "^25.5.0",
    "lefthook": "^2.1.4",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.56.0",
    "oxlint-tsgolint": "^0.17.0",
    "tsdown": "^0.21.4",
    "typescript": "^5.7.2",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "lefthook"
    ]
  }
}
